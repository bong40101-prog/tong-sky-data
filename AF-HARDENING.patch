+const send = async () => (await app.inject({ method: 'POST', url: '/api/search', payload: request() })).json()
+
+beforeEach(() => { vi.clearAllMocks(); invalidateQueryCaches(); vi.stubGlobal('fetch', network.fetch) })
+afterEach(() => vi.unstubAllGlobals())
+afterAll(async () => { await app.close() })
+
+describe('API → query → transport → parser → cache using synthetic airline responses', () => {
+  it('publishes the exact round-trip miles and tax total', async () => {
+    network.fetch.mockImplementation(async (_url: unknown, init: RequestInit) => {
+      const body = JSON.parse(init.body as string) as { operationName: string }
+      return response(body.operationName === 'SearchResultAvailableOffersQuery' ? offers() : calendar())
+    })
+    const result = await send()
+    expect(result.status).toBe('complete')
+    expect(result.offers[0].prices[0]).toMatchObject({ miles: 90000, taxes: 319.66 })
+    expect(network.fetch).toHaveBeenCalledTimes(2)
+    expect(network.navigate).not.toHaveBeenCalled()
+  })
+  it('never publishes or caches HTTP503 as no seats', async () => {
+    network.fetch.mockImplementation(async (_url: unknown, init: RequestInit) => {
+      const body = JSON.parse(init.body as string) as { operationName: string }
+      return body.operationName === 'SearchResultAvailableOffersQuery' ? response({ message: 'fixture failure' }, 503) : response(calendar())
+    })
+    expect((await send()).status).toBe('blocked')
+    expect((await send()).status).toBe('blocked')
+    expect(network.fetch).toHaveBeenCalledTimes(8)
+  })
+  it('rejects malformed HTTP200 and recovers on the next valid query', async () => {
+    network.fetch.mockResolvedValueOnce(response(calendar())).mockResolvedValueOnce(response({ data: { availableOffers: null } }))
+    const first = await send()
+    expect(first.status).toBe('blocked')
+    expect(first.authRequired).toBe(false)
+    network.fetch.mockResolvedValueOnce(response(calendar())).mockResolvedValueOnce(response(offers()))
+    expect((await send()).status).toBe('complete')
+    expect(network.fetch).toHaveBeenCalledTimes(4)
+  })
+  it('caches a confirmed explicit empty list, with no repeated request', async () => {
+    network.fetch.mockResolvedValueOnce(response(calendar())).mockResolvedValueOnce(response({ data: { availableOffers: { offerItineraries: [] } } }))
+    expect((await send()).status).toBe('empty')
+    const second = await send()
+    expect(second.status).toBe('empty')
+    expect(second.trace.cacheHit).toBe(true)
+    expect(network.fetch).toHaveBeenCalledTimes(2)
+  })
+  it.each([403, 429])('stops after one HTTP%i without navigation or a retry', async (status) => {
+    network.fetch.mockResolvedValue(response({ message: 'fixture rejection' }, status))
+    expect((await send()).status).toBe('blocked')
+    expect(network.fetch).toHaveBeenCalledTimes(1)
+    expect(network.navigate).not.toHaveBeenCalled()
+  })
+})
diff --git a/server/request-validation.ts b/server/request-validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9de0f3d63934cb0af4c05f237814e24ddc6a5216
--- /dev/null
+++ b/server/request-validation.ts
@@ -0,0 +1,37 @@
+import { z } from 'zod'
+
+const stationSchema = z.object({
+  code: z.string().regex(/^[A-Z]{3}$/),
+  cityCode: z.string(), cityName: z.string(), countryName: z.string(), displayText: z.string(),
+  stationType: z.enum(['AIRPORT', 'CITY']), isOrigin: z.boolean(), isDestination: z.boolean(),
+})
+
+export const requestSchema = z.object({
+  origin: stationSchema, destination: stationSchema,
+  departureDate: z.string().date(), returnDate: z.string().date(),
+  flexibleDays: z.number().int().min(0).max(30),
+  tripLengthDays: z.number().int().min(1).max(30),
+  cabins: z.array(z.enum(['ECONOMY', 'PREMIUM', 'BUSINESS'])).min(1),
+  paymentMode: z.enum(['cash', 'miles', 'both']), adults: z.number().int().min(1).max(9),
+  maxStops: z.union([z.literal(0), z.literal(1), z.literal(2)]),
+  maxDurationHours: z.number().min(8).max(72),
+  nearbyAirports: z.boolean(), separateTickets: z.boolean(), longLayover: z.boolean(),
+  mileValueCents: z.number().min(0.1).max(10),
+}).superRefine((request, ctx) => {
+  if (request.origin.code === request.destination.code) {
+    ctx.addIssue({ code: z.ZodIssueCode.custom, path: ['destination'], message: 'Origin and destination must differ' })
+  }
+  if (request.returnDate <= request.departureDate) {
+    ctx.addIssue({ code: z.ZodIssueCode.custom, path: ['returnDate'], message: 'Return must follow departure' })
+  }
+  if (request.departureDate < new Date().toISOString().slice(0, 10)) {
+    ctx.addIssue({ code: z.ZodIssueCode.custom, path: ['departureDate'], message: 'Departure is in the past' })
+  }
+})
+
+export const exploreSchema = z.object({
+  origin: stationSchema, destination: stationSchema,
+  paymentMode: z.enum(['cash', 'both']).default('both'),
+}).refine((request) => request.origin.code !== request.destination.code, {
+  path: ['destination'], message: 'Origin and destination must differ',
+})
