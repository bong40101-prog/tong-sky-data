new file mode 100644
index 0000000000000000000000000000000000000000..ba61b78b96519420673f42661b2727190e70c722
--- /dev/null
+++ b/server/af/response-validation.ts
@@ -0,0 +1,118 @@
+export type ResponseFailureCategory = 'http' | 'graphql' | 'network' | 'malformed'
+
+export interface TransportFetchResult {
+  ok: boolean
+  status?: number
+  data?: unknown
+  error?: string
+  category?: ResponseFailureCategory
+}
+
+export interface GraphQlFailure {
+  ok: false
+  data?: undefined
+  error: string
+  category: ResponseFailureCategory
+  status?: number
+  code?: string
+  retriable: boolean
+  blocksFurtherRequests: boolean
+}
+
+export type GraphQlResult<T> = { ok: true; status: number; data: T; error?: undefined } | GraphQlFailure
+
+export class AirFranceResponseError extends Error {
+  readonly category: ResponseFailureCategory
+  readonly status?: number
+  readonly code?: string
+  readonly retriable: boolean
+  readonly blocksFurtherRequests: boolean
+
+  constructor(failure: GraphQlFailure) {
+    super(failure.error)
+    this.name = 'AirFranceResponseError'
+    this.category = failure.category
+    this.status = failure.status
+    this.code = failure.code
+    this.retriable = failure.retriable
+    this.blocksFurtherRequests = failure.blocksFurtherRequests
+  }
+}
+
+export const isRecord = (value: unknown): value is Record<string, unknown> => (
+  value !== null && typeof value === 'object' && !Array.isArray(value)
+)
+
+const transientHttp = new Set([408, 500, 502, 503, 504])
+const blockingHttp = new Set([401, 403, 429])
+
+const failure = (
+  category: ResponseFailureCategory,
+  error: string,
+  status?: number,
+  extra: Partial<Pick<GraphQlFailure, 'code' | 'blocksFurtherRequests'>> = {},
+): GraphQlFailure => ({
+  ok: false,
+  category,
+  error,
+  ...(status == null ? {} : { status }),
+  retriable: category === 'network' || (category === 'http' && transientHttp.has(status ?? 0)),
+  blocksFurtherRequests: category === 'malformed' || blockingHttp.has(status ?? 0),
+  ...extra,
+})
+
+const safeGraphQlCode = (error: Record<string, unknown>): string | undefined => {
+  const extensions = isRecord(error.extensions) ? error.extensions : undefined
+  if (typeof extensions?.code === 'string' && /^[A-Za-z][A-Za-z0-9_]{0,63}$/.test(extensions.code)) {
+    return extensions.code
+  }
+  // Preserve the existing query-version compatibility signal without logging provider text.
+  if (typeof error.message === 'string') {
+    if (/PersistedQueryNotFound/i.test(error.message)) return 'PersistedQueryNotFound'
+    if (/PersistedQueryNotSupported/i.test(error.message)) return 'PersistedQueryNotSupported'
+    if (/not authenticated|unauthenticated|session expired/i.test(error.message)) return 'UNAUTHENTICATED'
+  }
+  return undefined
+}
+
+/** Treat HTTP status, envelope shape and GraphQL errors identically for single and batch requests. */
+export const normalizeFetchResult = <T>(result: TransportFetchResult): GraphQlResult<T> => {
+  const status = result.status
+  if (status != null && (!Number.isInteger(status) || status < 100 || status > 599)) {
+    return failure('malformed', 'Invalid HTTP status')
+  }
+  if (status != null && blockingHttp.has(status)) return failure('http', `HTTP ${status}`, status)
+  if (!result.ok && result.category === 'malformed') {
+    return failure('malformed', 'Malformed JSON response', status)
+  }
+  if (status != null && (status < 200 || status >= 300)) {
+    return failure('http', `HTTP ${status}`, status)
+  }
+  if (!result.ok) {
+    const category = result.category === 'malformed' || status != null ? 'malformed' : 'network'
+    return failure(category, category === 'network' ? 'Network request failed' : 'Malformed JSON response', status)
+  }
+  if (status == null || !isRecord(result.data)) {
+    return failure('malformed', 'Malformed GraphQL response', status)
+  }
+  const payload = result.data
+  if (Object.hasOwn(payload, 'errors') && (!Array.isArray(payload.errors) || !payload.errors.every(isRecord))) {
+    return failure('malformed', 'Malformed GraphQL errors', status)
+  }
+  if (Array.isArray(payload.errors) && payload.errors.length) {
+    const codes = [...new Set(payload.errors.map(safeGraphQlCode).filter((code): code is string => Boolean(code)))]
+    const code = codes[0]
+    const blocksFurtherRequests = codes.some((value) => /^(UNAUTHENTICATED|FORBIDDEN|UNAUTHORIZED|RATE_LIMITED|TOO_MANY_REQUESTS)$/i.test(value))
+    return failure('graphql', `GraphQL error${codes.length ? ` (${codes.join(', ')})` : ''}`, status, {
+      ...(code ? { code } : {}), blocksFurtherRequests,
+    })
+  }
+  if (!Object.hasOwn(payload, 'data') || !isRecord(payload.data)) {
+    return failure('malformed', 'Missing GraphQL data', status)
+  }
+  return { ok: true, status, data: payload as T }
+}
+
+export const asResponseError = (failure: GraphQlFailure): AirFranceResponseError => (
+  new AirFranceResponseError(failure)
+)
