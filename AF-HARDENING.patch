index 0000000000000000000000000000000000000000..0de6c4a44ab617c66dccba8ecce5e8eddf3d8f17
--- /dev/null
+++ b/server/af/explore-cache-integration.test.ts
@@ -0,0 +1,99 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import type { SearchRequest } from '../../src/types.js'
+
+vi.mock('./browser.js', () => ({
+  withTransportLock: async (work: () => Promise<unknown>) => work(),
+  withRecoveredCollector: async (work: (page: object) => Promise<unknown>) => work({ waitForTimeout: vi.fn() }),
+  refreshCollectorPage: vi.fn(),
+}))
+vi.mock('./session-warm.js', () => ({ warmAkamaiSession: vi.fn() }))
+vi.mock('./reward-session.js', () => ({
+  prepareRewardSession: vi.fn(async () => ({ searchStateUuid: 'offline-session', companions: [] })),
+  rewardTransportOptions: {},
+}))
+vi.mock('./hash-fallback.js', () => ({
+  createActiveHashes: () => ({ lowestFare: 'offline-hash' }),
+  withHashFallback: async (_hashes: unknown, work: () => Promise<unknown>) => work(),
+}))
+vi.mock('./transport.js', () => ({
+  postGraphQlWithRetry: vi.fn(async (_page: unknown, _operation: string, _hash: string, variables: {
+    bookingFlow: string
+    lowestFareOffersRequest: { requestedConnections: Array<{ departureDate: string }> }
+  }) => ({
+    data: { lowestFareOffers: { lowestOffers: [{
+      flightDate: variables.lowestFareOffersRequest.requestedConnections[0].departureDate,
+      currency: variables.bookingFlow === 'REWARD' ? 'MILES' : 'EUR',
+      totalPrice: 1000,
+      totalPriceItinerary: 2000,
+    }] } },
+  })),
+}))
+
+import { exploreCashFares } from './cash-explore.js'
+import { exploreRewardFares } from './reward-explore.js'
+import { invalidateQueryCaches } from './explore-cache.js'
+import { postGraphQlWithRetry } from './transport.js'
+
+const sample = (): SearchRequest => ({
+  origin: { code: 'ICN', stationType: 'AIRPORT', cityCode: 'SEL', cityName: 'Seoul', countryName: 'Korea', displayText: 'Seoul', isOrigin: true, isDestination: true },
+  destination: { code: 'CDG', stationType: 'AIRPORT', cityCode: 'PAR', cityName: 'Paris', countryName: 'France', displayText: 'Paris', isOrigin: true, isDestination: true },
+  departureDate: '2026-11-01', returnDate: '2026-11-11', flexibleDays: 0, tripLengthDays: 10,
+  cabins: ['ECONOMY'], paymentMode: 'miles', adults: 1, maxStops: 2, maxDurationHours: 48,
+  nearbyAirports: false, separateTickets: false, longLayover: false, mileValueCents: 1.2,
+})
+
+beforeEach(() => {
+  invalidateQueryCaches()
+  vi.clearAllMocks()
+})
+
+describe.each([
+  ['cash', exploreCashFares],
+  ['reward', exploreRewardFares],
+] as const)('%s Explorer cache wiring', (_name, explore) => {
+  it('requests a fresh horizon after a departure month change', async () => {
+    const first = await explore(sample())
+    const unchanged = await explore(sample())
+    const changed = await explore({ ...sample(), departureDate: '2026-12-01', returnDate: '2026-12-11' })
+    expect(first.cacheHit).toBe(false)
+    expect(unchanged.cacheHit).toBe(true)
+    expect(changed.cacheHit).toBe(false)
+    expect(first.months[0].month).toBe('2026-11')
+    expect(changed.months[0].month).toBe('2026-12')
+    expect(postGraphQlWithRetry).toHaveBeenCalledTimes(4)
+  })
+
+  it('deduplicates simultaneous identical requests without sharing mutable output', async () => {
+    const [a, b] = await Promise.all([explore(sample()), explore(sample())])
+    expect([a.cacheHit, b.cacheHit]).toEqual([false, true])
+    expect(postGraphQlWithRetry).toHaveBeenCalledTimes(2)
+    a.months.splice(0)
+    expect(b.months).toHaveLength(1)
+    expect((await explore(sample())).months).toHaveLength(1)
+  })
+
+  it('snapshots query inputs before asynchronous work begins', async () => {
+    const mutable = sample()
+    const pending = explore(mutable)
+    mutable.departureDate = '2026-12-01'
+    mutable.returnDate = '2026-12-11'
+    expect((await pending).months[0].month).toBe('2026-11')
+    expect((await explore(sample())).cacheHit).toBe(true)
+  })
+
+  it('invalidates a completed result on an account/session change', async () => {
+    await explore(sample())
+    invalidateQueryCaches()
+    expect((await explore(sample())).cacheHit).toBe(false)
+    expect(postGraphQlWithRetry).toHaveBeenCalledTimes(4)
+  })
+
+  it('does not retain an upstream failure as an empty calendar', async () => {
+    vi.mocked(postGraphQlWithRetry).mockRejectedValueOnce(new Error('offline upstream failure'))
+    await expect(explore(sample())).rejects.toThrow('offline upstream failure')
+    const retry = await explore(sample())
+    expect(retry.cacheHit).toBe(false)
+    expect(retry.months).toHaveLength(1)
+    expect(postGraphQlWithRetry).toHaveBeenCalledTimes(3)
+  })
+})
