diff --git a/server/smoke-dates.ts b/server/smoke-dates.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cf8fb3e9be045637c6f74ddf89ff7fb3e9c2a293
--- /dev/null
+++ b/server/smoke-dates.ts
@@ -0,0 +1,16 @@
+import { isIsoDate } from './af/data-validation.js'
+import { addDays } from './af/variables.js'
+
+/** Smoke tests always use an explicit valid future journey, never a stale hard-coded date. */
+export const smokeDates = (environment: Record<string, string | undefined>, now = new Date()) => {
+  const today = now.toISOString().slice(0, 10)
+  const departureDate = environment.AF_SMOKE_DEPARTURE_DATE ?? addDays(today, 30)
+  const returnDate = environment.AF_SMOKE_RETURN_DATE ?? addDays(departureDate, 10)
+  const flexibleDays = Number(environment.AF_SMOKE_FLEX_DAYS ?? 0)
+  if (!isIsoDate(departureDate) || !isIsoDate(returnDate) || departureDate < today || returnDate <= departureDate) {
+    throw new Error('Invalid future smoke-test dates')
+  }
+  if (!Number.isInteger(flexibleDays) || flexibleDays < 0 || flexibleDays > 30) throw new Error('Invalid smoke flexibility')
+  const tripLengthDays = (Date.parse(returnDate) - Date.parse(departureDate)) / 86_400_000
+  return { departureDate, returnDate, tripLengthDays, flexibleDays }
+}
