+import { describe, expect, it } from 'vitest'
+import { candidateRequests } from './af/variables.js'
+import { parseMonthlyFares, parseLowestFarePayload } from './af/parsers.js'
+import { smokeDates } from './smoke-dates.js'
+import type { SearchRequest } from '../src/types.js'
+
+describe('exact journey dates and mileage', () => {
+  it('preserves the explicit return date when flexible stay metadata differs', () => {
+    const result = candidateRequests({ departureDate: '2026-12-07', returnDate: '2026-12-27', tripLengthDays: 10, flexibleDays: 1 } as SearchRequest, '2026-10-31')
+    expect(result.map((value) => [value.departureDate, value.returnDate])).toEqual([
+      ['2026-12-06', '2026-12-26'], ['2026-12-07', '2026-12-27'], ['2026-12-08', '2026-12-28'],
+    ])
+  })
+  it('never queries past days in a flexible window', () => {
+    const result = candidateRequests({ departureDate: '2026-10-31', returnDate: '2026-11-10', flexibleDays: 30 } as SearchRequest, '2026-10-31')
+    expect(result).toHaveLength(31)
+    expect(result[0].departureDate).toBe('2026-10-31')
+  })
+  it('rejects past target dates', () => {
+    expect(() => candidateRequests({ departureDate: '2026-10-30', returnDate: '2026-11-10', flexibleDays: 0 } as SearchRequest, '2026-10-31')).toThrow('past')
+  })
+  it('rejects fractional reward miles while accepting decimal taxes', () => {
+    expect(() => parseMonthlyFares([{ flightDate: '2026-12-07', totalPriceItinerary: 0.5 }], 'REWARD')).toThrow('fare amount')
+    expect(() => parseLowestFarePayload({ data: { lowestFareOffers: { lowestOffers: [{ flightDate: '2026-12-07', totalPrice: 0.5 }] } } }, 'REWARD')).toThrow('fare amount')
+    expect(parseMonthlyFares([{ flightDate: '2026-12-07', totalPriceItinerary: 95000, totalTaxDetails: { totalPrice: 319.66 } }], 'REWARD')[0].taxes).toBe(319.66)
+  })
+})
+
+describe('future smoke-test journeys without starting a collection', () => {
+  const now = new Date('2026-10-31T00:00:00Z')
+  it('chooses future dates automatically', () => {
+    expect(smokeDates({}, now)).toEqual({ departureDate: '2026-11-30', returnDate: '2026-12-10', tripLengthDays: 10, flexibleDays: 0 })
+  })
+  it.each([
+    { AF_SMOKE_DEPARTURE_DATE: '2026-10-02' },
+    { AF_SMOKE_DEPARTURE_DATE: '2026-12-01', AF_SMOKE_RETURN_DATE: '2026-11-01' },
+    { AF_SMOKE_FLEX_DAYS: '31' }, { AF_SMOKE_FLEX_DAYS: 'invalid' },
+  ])('rejects invalid smoke parameters: %j', (environment) => {
+    expect(() => smokeDates(environment, now)).toThrow()
+  })
+})
