@@ -0,0 +1,140 @@
+import type { SearchRequest } from '../../src/types.js'
+import { CACHE_TTL_MS } from './hashes.js'
+import type { BookingFlow, ExploreCapture, SearchCapture } from './types.js'
+
+/** Include the whole query horizon and station kind; display labels are not query inputs. */
+export const exploreCacheKey = (flow: BookingFlow, request: SearchRequest): string => JSON.stringify({
+  flow,
+  origin: [request.origin.code, request.origin.stationType],
+  destination: [request.destination.code, request.destination.stationType],
+  departureDate: request.departureDate,
+  returnDate: request.returnDate,
+  adults: request.adults,
+  cabins: [...new Set(request.cabins)].sort(),
+  paymentMode: request.paymentMode,
+  flexibleDays: request.flexibleDays,
+  tripLengthDays: request.tripLengthDays,
+  maxStops: request.maxStops,
+  maxDurationHours: request.maxDurationHours,
+  nearbyAirports: request.nearbyAirports,
+  separateTickets: request.separateTickets,
+  longLayover: request.longLayover,
+  mileValueCents: request.mileValueCents,
+})
+
+interface CacheOptions<T> {
+  ttlMs: number
+  maxEntries?: number
+  maxInFlight?: number
+  now?: () => number
+  shouldCache?: (value: T) => boolean
+}
+
+interface Entry<T> {
+  value: T
+  expiresAt: number
+}
+
+/** Successful, detached snapshots only. Failed work never becomes an empty cached result. */
+export class ExploreResultCache<T> {
+  private readonly entries = new Map<string, Entry<T>>()
+  private readonly inFlight = new Map<string, Promise<T>>()
+  private readonly ttlMs: number
+  private readonly maxEntries: number
+  private readonly maxInFlight: number
+  private readonly now: () => number
+  private readonly shouldCache: (value: T) => boolean
+  private generation = 0
+
+  constructor({ ttlMs, maxEntries = 128, maxInFlight = 32, now = Date.now, shouldCache = () => true }: CacheOptions<T>) {
+    if (!Number.isFinite(ttlMs) || ttlMs < 0) throw new TypeError('Cache TTL must be finite and non-negative')
+    if (!Number.isSafeInteger(maxEntries) || maxEntries < 1) throw new TypeError('Cache capacity must be positive')
+    if (!Number.isSafeInteger(maxInFlight) || maxInFlight < 1) throw new TypeError('Pending capacity must be positive')
+    this.ttlMs = ttlMs
+    this.maxEntries = maxEntries
+    this.maxInFlight = maxInFlight
+    this.now = now
+    this.shouldCache = shouldCache
+  }
+
+  /** Called when a member session changes. Old pending work may finish but cannot repopulate the cache. */
+  clear(): void {
+    this.generation += 1
+    this.entries.clear()
+    this.inFlight.clear()
+  }
+
+  private prune(time: number): void {
+    for (const [key, entry] of this.entries) {
+      if (entry.expiresAt <= time) this.entries.delete(key)
+    }
+  }
+
+  async getOrLoad(key: string, load: () => Promise<T>): Promise<{ capture: T; cacheHit: boolean }> {
+    const time = this.now()
+    this.prune(time)
+    const cached = this.entries.get(key)
+    if (cached) {
+      // Refresh LRU position without extending the expiry.
+      this.entries.delete(key)
+      this.entries.set(key, cached)
+      return { capture: structuredClone(cached.value), cacheHit: true }
+    }
+    const pending = this.inFlight.get(key)
+    if (pending) {
+      const generation = this.generation
+      const value = await pending
+      if (generation !== this.generation) throw new Error('Calendar session changed during query')
+      return { capture: structuredClone(value), cacheHit: true }
+    }
+    if (this.inFlight.size >= this.maxInFlight) throw new Error('Too many pending calendar queries')
+
+    const generation = this.generation
+    // Defer work until its promise is registered so even synchronous failures clean up correctly.
+    const work = Promise.resolve().then(() => {
+      if (generation !== this.generation) throw new Error('Calendar session changed during query')
+      return load()
+    }).then((value) => structuredClone(value))
+    this.inFlight.set(key, work)
+    try {
+      const value = await work
+      if (generation !== this.generation) throw new Error('Calendar session changed during query')
+      if (generation === this.generation && this.inFlight.get(key) === work && this.ttlMs > 0 && this.shouldCache(value)) {
+        this.prune(this.now())
+        while (this.entries.size >= this.maxEntries) {
+          const oldest = this.entries.keys().next().value
+          if (oldest == null) break
+          this.entries.delete(oldest)
+        }
+        this.entries.set(key, { value, expiresAt: this.now() + this.ttlMs })
+      }
+      return { capture: structuredClone(value), cacheHit: false }
+    } finally {
+      // A cleared session may already have a newer promise for this key.
+      if (this.inFlight.get(key) === work) this.inFlight.delete(key)
+    }
+  }
+}
+
+export const cashExploreCache = new ExploreResultCache<ExploreCapture>({ ttlMs: CACHE_TTL_MS })
+export const rewardExploreCache = new ExploreResultCache<ExploreCapture>({ ttlMs: CACHE_TTL_MS })
+export const cashSearchCache = new ExploreResultCache<SearchCapture>({
+  ttlMs: CACHE_TTL_MS,
+  shouldCache: (capture) => !capture.warnings?.length,
+})
+export const rewardSearchCache = new ExploreResultCache<SearchCapture>({
+  ttlMs: CACHE_TTL_MS,
+  shouldCache: (capture) => !capture.warnings?.length,
+})
+
+export const invalidateExploreCaches = (): void => {
+  cashExploreCache.clear()
+  rewardExploreCache.clear()
+}
+
+/** Invalidate all member-sensitive queries after login, logout, profile import, or collector close. */
+export const invalidateQueryCaches = (): void => {
+  invalidateExploreCaches()
+  cashSearchCache.clear()
+  rewardSearchCache.clear()
+}
