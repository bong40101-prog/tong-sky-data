+    expect(response.statusCode).toBe(400)
+    expect(api.searchReward).not.toHaveBeenCalled()
+    expect(api.searchCash).not.toHaveBeenCalled()
+  })
+  it.each([403, 429, 503])('HTTP %i is blocked, not empty or an authentication error', async (status) => {
+    api.searchReward.mockRejectedValue(failed(status))
+    const response = (await app.inject({ method: 'POST', url: '/api/search', payload: request() })).json()
+    expect(response.status).toBe('blocked')
+    expect(response.authRequired).toBe(false)
+    expect(response.warnings.length).toBeGreaterThan(0)
+  })
+  it('HTTP401 requires authentication', async () => {
+    api.searchReward.mockRejectedValue(failed(401))
+    const response = (await app.inject({ method: 'POST', url: '/api/search', payload: request() })).json()
+    expect(response.status).toBe('auth-required')
+    expect(response.authRequired).toBe(true)
+  })
+  it('a confirmed empty response remains empty', async () => {
+    const response = (await app.inject({ method: 'POST', url: '/api/search', payload: request() })).json()
+    expect(response.status).toBe('empty')
