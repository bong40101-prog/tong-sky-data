+      await warmAkamaiSession(page); await prewarmCollector()
+      expect(mocks.navigate).not.toHaveBeenCalled(); expect(mocks.fetch).not.toHaveBeenCalled()
+    } finally { vi.unstubAllGlobals() }
+  })
+  it.each([403, 429, 503])('preserves HTTP%i from account checking', async (status) => {
