+  })
+  it('only missing authentication becomes an auth error', async () => {
+    mocks.retry.mockRejectedValue(failure(401))
+    await expect(prepareRewardSession(page, request)).rejects.toBeInstanceOf(FlyingBlueAuthError)
+  })
