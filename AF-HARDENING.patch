diff --git a/server/af/data-validation.ts b/server/af/data-validation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7ff21ae5112e3c2f75c0b999d49f830bc9106f75
--- /dev/null
+++ b/server/af/data-validation.ts
@@ -0,0 +1,28 @@
+import { AirFranceResponseError, isRecord } from './response-validation.js'
+
+export const dataError = (detail: string): AirFranceResponseError => new AirFranceResponseError({
+  ok: false, category: 'malformed', error: detail, retriable: false, blocksFurtherRequests: true,
+})
+
+export const recordValue = (value: unknown, field: string): Record<string, unknown> => {
+  if (!isRecord(value)) throw dataError(`Malformed ${field}`)
+  return value
+}
+
+export const arrayValue = (value: unknown, field: string): unknown[] => {
+  if (!Array.isArray(value)) throw dataError(`Missing or malformed ${field}`)
+  return value
+}
+
+export const isIsoDate = (value: unknown): value is string => {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false
+  const time = Date.parse(`${value}T00:00:00Z`)
+  return Number.isFinite(time) && new Date(time).toISOString().slice(0, 10) === value
+}
+
+export const nonnegativeNumber = (value: unknown, field: string, integer = false): number => {
+  if (typeof value !== 'number' || !Number.isFinite(value) || value < 0 || (integer && !Number.isSafeInteger(value))) {
+    throw dataError(`Invalid ${field}`)
+  }
+  return value
+}
