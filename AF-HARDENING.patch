+import { describe, expect, it } from 'vitest'
+import { parseAvailableOffers, parseDailyTopFares, parseLowestFarePayload, parseMonthlyFares } from './parsers.js'
+import { AirFranceResponseError } from './response-validation.js'
+
+const calendar = (rows: unknown) => ({ data: { lowestFareOffers: { lowestOffers: rows } } })
+const offer = () => ({
+  data: { availableOffers: { offerItineraries: [{
+    activeConnection: { segments: [{ origin: { code: 'ICN' }, destination: { code: 'CDG' } }] },
+    flightProducts: [
+      { connections: [{ cabinClass: 'ECONOMY', price: { amount: 100, currencyCode: 'EUR' } }, { price: { amount: 20, currencyCode: 'EUR' } }] },
+      { connections: [{ cabinClass: 'BUSINESS', price: { amount: 200, currencyCode: 'EUR' } }, { price: { amount: 80, currencyCode: 'EUR' } }] },
+    ],
+    upsellCabinProducts: [{ connections: [
+      { cabinClass: 'ECONOMY', price: { amount: 100, currencyCode: 'EUR' } },
+      { cabinClass: 'BUSINESS', price: { amount: 200, currencyCode: 'EUR' } },
+    ] }],
+  }] } },
+})
+
+describe('strict response interpretation', () => {
+  it.each([null, [], {}, { data: null }, { data: {} }, { data: { availableOffers: {} } }, { data: { availableOffers: { offerItineraries: null } } }])('rejects missing offer schema: %j', (payload) => {
+    expect(() => parseAvailableOffers(payload as never)).toThrow(AirFranceResponseError)
+  })
+  it('only accepts an explicit empty offer list as no seats', () => {
+    expect(parseAvailableOffers({ data: { availableOffers: { offerItineraries: [] } } })).toEqual([])
+  })
+  it.each([null, [], {}, { data: {} }, calendar(null), calendar({}), calendar([null])])('rejects malformed calendar: %j', (payload) => {
+    expect(() => parseLowestFarePayload(payload)).toThrow(AirFranceResponseError)
+  })
+  it('preserves a valid empty calendar', () => expect(parseLowestFarePayload(calendar([]))).toEqual([]))
+  it('rejects partial GraphQL errors even when data is present', () => {
+    expect(() => parseLowestFarePayload({ ...calendar([]), errors: [{ message: 'failed' }] })).toThrow(AirFranceResponseError)
+  })
+  it.each(['2026-02-29', '2026-13-01', '2026-12-32', '2026-1-01', 'not-a-date'])('rejects impossible date %s', (flightDate) => {
+    expect(() => parseLowestFarePayload(calendar([{ flightDate, totalPrice: 100 }]))).toThrow('fare date')
+  })
+  it('accepts leap day and an explicit no-flight record', () => {
+    expect(parseLowestFarePayload(calendar([{ flightDate: '2028-02-29', noFlight: true }]))).toHaveLength(1)
+  })
+  it('rejects incomplete available fare rather than calling it empty', () => {
+    expect(() => parseLowestFarePayload(calendar([{ flightDate: '2026-12-01' }]))).toThrow('Missing fare amount')
+  })
+  it.each([-1, NaN, Infinity, '100'])('rejects invalid money %j', (amount) => {
+    expect(() => parseMonthlyFares([{ flightDate: '2026-12-01', totalPrice: amount as number }], 'REWARD')).toThrow('fare amount')
+    expect(() => parseDailyTopFares([{ flightDate: '2026-12-01', totalPrice: amount as number }], '2026-12-01')).toThrow('fare amount')
+  })
+  it('does not match two missing IDs to the first product', () => {
+    expect(parseAvailableOffers(offer()).at(0)?.prices).toMatchObject([
+      { cabin: 'ECONOMY', cash: 120 }, { cabin: 'BUSINESS', cash: 280 },
+    ])
+  })
+  it('rejects ambiguous matching products', () => {
+    const payload = offer()
+    const itinerary = payload.data.availableOffers.offerItineraries[0]
+    itinerary.flightProducts.push(structuredClone(itinerary.flightProducts[0]))
+    expect(() => parseAvailableOffers(payload)).toThrow('ambiguous')
+  })
+  it('rejects an incomplete round trip instead of publishing a one-way total', () => {
+    const payload = offer()
+    payload.data.availableOffers.offerItineraries[0].flightProducts[0].connections.pop()
+    expect(() => parseAvailableOffers(payload)).toThrow('Incomplete round-trip')
+  })
+  it('rejects invalid return-leg money', () => {
+    const payload = offer()
+    payload.data.availableOffers.offerItineraries[0].flightProducts[0].connections[1].price.amount = -1
+    expect(() => parseAvailableOffers(payload)).toThrow('round-trip amount')
+  })
+  it('rejects missing itinerary segments', () => {
+    const payload = offer()
+    payload.data.availableOffers.offerItineraries[0].activeConnection.segments = []
+    expect(() => parseAvailableOffers(payload)).toThrow('flight segments')
+  })
+})
