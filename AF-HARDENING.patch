+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { Page } from 'patchright'
+import type { ExploreMonthItem, RawOffer, SearchRequest } from '../../src/types.js'
+import type { AvailableOffersPayload } from './types.js'
+import { AirFranceResponseError, normalizeFetchResult } from './response-validation.js'
+import type { GraphQlResult } from './response-validation.js'
+
+const mocked = vi.hoisted(() => ({
+  refresh: vi.fn(),
+  wait: vi.fn(async () => undefined),
+  batch: vi.fn(),
+  request: vi.fn(),
+  parse: vi.fn(),
+}))
+
+vi.mock('./browser.js', () => ({
+  withTransportLock: async (work: () => Promise<unknown>) => work(),
+  withRecoveredCollector: async (work: (page: unknown) => Promise<unknown>) => work({ waitForTimeout: mocked.wait }),
+  refreshCollectorPage: mocked.refresh,
+}))
+vi.mock('./session-warm.js', () => ({ warmAkamaiSession: vi.fn() }))
+vi.mock('./reward-session.js', () => ({
+  prepareRewardSession: vi.fn(async () => ({ searchStateUuid: 'offline', companions: [] })),
+  rewardTransportOptions: {},
+}))
+vi.mock('./transport.js', () => ({
+  buildGraphQlBody: vi.fn(() => ({})),
+  postGraphQlBatch: mocked.batch,
+  postGraphQlWithRetry: mocked.request,
+}))
+vi.mock('./parsers.js', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('./parsers.js')>()
+  return { ...actual, parseAvailableOffers: mocked.parse }
+})
+
+import { searchCashOffers } from './cash.js'
+import { searchRewardOffers } from './reward.js'
+import { loadExploreMonths } from './explore-chunks.js'
+import { invalidateQueryCaches } from './explore-cache.js'
+import { FlyingBlueAuthError } from './hashcash.js'
+
+const station = (code: string) => ({
+  code, cityCode: code, cityName: code, countryName: 'Test', displayText: code,
+  stationType: 'AIRPORT', isOrigin: true, isDestination: true,
+})
+
+const request = (overrides: Partial<SearchRequest> = {}): SearchRequest => ({
+  origin: station('NCE'), destination: station('RUN'),
+  departureDate: '2026-12-07', returnDate: '2026-12-17',
+  flexibleDays: 0, tripLengthDays: 10, cabins: ['ECONOMY'], paymentMode: 'cash', adults: 1,
+  maxStops: 2, maxDurationHours: 48, nearbyAirports: true, separateTickets: false,
+  longLayover: false, mileValueCents: 1.2, ...overrides,
+})
+
+const offer: RawOffer = {
+  id: 'offline', segments: [], prices: [{ cabin: 'ECONOMY', cash: 500, miles: 95000, taxes: 100 }],
+  source: 'live', verifiedAt: '2026-10-31T00:00:00Z', singleTicket: true, bagsIncluded: null,
+}
+const success = (): GraphQlResult<AvailableOffersPayload> => ({
+  ok: true, status: 200, data: { data: { availableOffers: { offerItineraries: [] } } },
+})
+const failed = (status: number): GraphQlResult<AvailableOffersPayload> => normalizeFetchResult({
+  ok: true, status, data: { message: 'provider failure' },
+})
+const malformed = () => new AirFranceResponseError({
+  ok: false, category: 'malformed', error: 'Invalid offer response',
+  retriable: false, blocksFurtherRequests: true,
+})
+
+beforeEach(() => {
+  vi.useFakeTimers({ toFake: ['Date'] })
+  vi.setSystemTime(new Date('2026-10-31T00:00:00Z'))
+  invalidateQueryCaches()
+  mocked.refresh.mockReset()
+  mocked.wait.mockReset().mockResolvedValue(undefined)
+  mocked.batch.mockReset().mockResolvedValue([success()])
+  mocked.request.mockReset().mockResolvedValue({ data: { lowestFareOffers: { lowestOffers: [] } } })
+  mocked.parse.mockReset().mockReturnValue([structuredClone(offer)])
+})
+
+afterEach(() => vi.useRealTimers())
+
+describe('search failure classification', () => {
+  it.each([401, 403, 429, 503])('cash HTTP %s is an error, never an empty successful result', async (status) => {
+    mocked.batch.mockResolvedValue([failed(status)])
+    await expect(searchCashOffers(request())).rejects.toMatchObject({ name: 'AirFranceResponseError', status })
+    expect(mocked.batch).toHaveBeenCalledTimes(1)
+    expect(mocked.parse).not.toHaveBeenCalled()
+  })
+
+  it.each([403, 429, 503])('reward HTTP %s is preserved instead of mislabeled authentication failure', async (status) => {
+    mocked.batch.mockResolvedValue([failed(status)])
+    await expect(searchRewardOffers(request({ paymentMode: 'miles' }))).rejects.toMatchObject({ name: 'AirFranceResponseError', status })
+    expect(mocked.batch).toHaveBeenCalledTimes(1)
+  })
+
+  it('reward HTTP 401 still prompts authentication', async () => {
+    mocked.batch.mockResolvedValue([failed(401)])
+    await expect(searchRewardOffers(request({ paymentMode: 'miles' }))).rejects.toBeInstanceOf(FlyingBlueAuthError)
+  })
+
+  it.each(['cash', 'miles'] as const)('%s malformed payload has no fallback network replay', async (paymentMode) => {
+    mocked.parse.mockImplementation(() => { throw malformed() })
+    const search = paymentMode === 'cash' ? searchCashOffers : searchRewardOffers
+    await expect(search(request({ paymentMode }))).rejects.toMatchObject({ category: 'malformed' })
+    expect(mocked.batch).toHaveBeenCalledTimes(1)
+    expect(mocked.refresh).not.toHaveBeenCalled()
+  })
+
+  it.each(['cash', 'miles'] as const)('%s failed flexible search is rejected rather than cached as no seats', async (paymentMode) => {
+    mocked.batch.mockResolvedValue([failed(503), failed(503), failed(503)])
+    const search = paymentMode === 'cash' ? searchCashOffers : searchRewardOffers
+    const query = request({ paymentMode, flexibleDays: 1 })
+    await expect(search(query)).rejects.toMatchObject({ status: 503 })
+    await expect(search(query)).rejects.toMatchObject({ status: 503 })
+    expect(mocked.batch).toHaveBeenCalledTimes(2)
+  })
+
+  it.each(['cash', 'miles'] as const)('%s partial success is returned with warnings and is not cached', async (paymentMode) => {
+    mocked.batch.mockResolvedValue([success(), failed(503), success()])
+    const search = paymentMode === 'cash' ? searchCashOffers : searchRewardOffers
+    const query = request({ paymentMode, flexibleDays: 1 })
+    const first = await search(query)
+    const second = await search(query)
+    expect(first.offers).toHaveLength(2)
+    expect(first.warnings).toHaveLength(1)
+    expect(first.cacheHit).toBe(false)
+    expect(second.cacheHit).toBe(false)
+    expect(mocked.batch).toHaveBeenCalledTimes(2)
+  })
+
+  it.each(['cash', 'miles'] as const)('%s confirmed empty success can be cached', async (paymentMode) => {
+    mocked.parse.mockReturnValue([])
+    const search = paymentMode === 'cash' ? searchCashOffers : searchRewardOffers
+    const query = request({ paymentMode })
+    const first = await search(query)
+    const second = await search(query)
+    expect(first.offers).toEqual([])
+    expect(first.warnings).toEqual([])
+    expect(second.cacheHit).toBe(true)
+    expect(mocked.batch).toHaveBeenCalledTimes(1)
+  })
+
+  it.each(['cash', 'miles'] as const)('%s session invalidation forces a fresh search', async (paymentMode) => {
+    const search = paymentMode === 'cash' ? searchCashOffers : searchRewardOffers
+    const query = request({ paymentMode })
+    await search(query)
+    invalidateQueryCaches()
+    const second = await search(query)
+    expect(second.cacheHit).toBe(false)
+    expect(mocked.batch).toHaveBeenCalledTimes(2)
+  })
+
+  it.each(['cash', 'miles'] as const)('%s snapshots the request before asynchronous work starts', async (paymentMode) => {
+    const search = paymentMode === 'cash' ? searchCashOffers : searchRewardOffers
+    const query = request({ paymentMode })
+    const pending = search(query)
+    query.origin.code = 'CDG'
+    query.departureDate = '2027-01-01'
+    await pending
+    const variables = mocked.request.mock.calls[0][3]
+    expect(variables.lowestFareOffersRequest.requestedConnections[0].origin.code).toBe('NCE')
+    expect(variables.lowestFareOffersRequest.requestedConnections[0].departureDate).toBe('2026-12-07')
+    expect((await search(request({ paymentMode }))).cacheHit).toBe(true)
+  })
+})
+
+describe('Explorer gap fill respects the transport retry budget', () => {
+  const page = { waitForTimeout: mocked.wait } as unknown as Page
+  const seeds = ['2026-12', '2027-01', '2027-02', '2027-03', '2027-04', '2027-05']
+    .map((month) => ({ month, label: month }))
+
+  it.each([403, 429, 503])('does not refresh and replay HTTP %s', async (status) => {
+    const result = failed(status)
+    if (result.ok) throw new Error('Invalid test fixture')
+    const error = new AirFranceResponseError(result)
+    const load = vi.fn(async () => { throw error })
+    await expect(loadExploreMonths(page, seeds.slice(0, 1), load)).rejects.toBe(error)
+    expect(load).toHaveBeenCalledTimes(1)
+    expect(mocked.refresh).not.toHaveBeenCalled()
+  })
+
+  it('stops scheduling new months after a loader failure', async () => {
+    const load = vi.fn(async () => { throw malformed() })
+    await expect(loadExploreMonths(page, seeds, load)).rejects.toMatchObject({ category: 'malformed' })
+    expect(load.mock.calls.length).toBeLessThanOrEqual(3)
+    expect(mocked.refresh).not.toHaveBeenCalled()
+  })
+
+  it('keeps successful months ordered and permits a confirmed empty month', async () => {
+    const load = vi.fn(async (seed: { month: string; label: string }): Promise<ExploreMonthItem | undefined> => (
+      seed.month === '2027-01' ? undefined : { ...seed, cashTop3: [], milesTop3: [] }
+    ))
+    const result = await loadExploreMonths(page, seeds, load)
+    expect(result.map((month) => month.month)).toEqual(seeds.map((seed) => seed.month).filter((month) => month !== '2027-01'))
+  })
+})
