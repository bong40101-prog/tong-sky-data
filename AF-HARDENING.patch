+    expect(response.warnings.length).toBeGreaterThan(0)
+    expect(response.authRequired).toBe(false)
+  })
+  it('does not label a failed reward query as empty when cash is empty', async () => {
+    api.searchReward.mockRejectedValue(failed(503))
+    const response = (await app.inject({ method: 'POST', url: '/api/search', payload: { ...request(), paymentMode: 'both' } })).json()
+    expect(response.status).toBe('blocked')
+  })
+  it('rejects a same-airport exploration before collection', async () => {
+    const response = await app.inject({ method: 'POST', url: '/api/explore', payload: { origin: station('ICN'), destination: station('ICN') } })
