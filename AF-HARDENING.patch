+
+describe('session boundaries', () => {
+  it.each([
+    ['open', () => openFlyingBlueLogin()], ['status', () => isFlyingBlueAuthenticated()],
+    ['confirm', () => confirmFlyingBlueSession()], ['import fixture', () => importFlyingBlueSession('/offline-fixture.json')],
+    ['close', () => closeAirFranceTransport()],
+  ] as const)('%s invalidates all query caches', async (_name, boundary) => {
+    for (const cache of caches) await cache.getOrLoad('same', async () => loader())
+    await boundary()
+    for (const cache of caches) expect((await cache.getOrLoad('same', async () => loader())).cacheHit).toBe(false)
+  })
