 const roundMoney = (value: number): number => Math.round((value + Number.EPSILON) * 100) / 100
 
+/** A missing calendar field is a failed query; an explicit [] is a confirmed empty calendar. */
+export const parseLowestFarePayload = (payload: unknown, flow?: BookingFlow): LowestFareOffer[] => {
+  const result = normalizeFetchResult<{ data: Record<string, unknown> }>({ ok: true, status: 200, data: payload })
+  if (!result.ok) throw asResponseError(result)
+  const calendar = recordValue(result.data.data.lowestFareOffers, 'lowest fare calendar')
+  return arrayValue(calendar.lowestOffers, 'lowest fare rows').map((value) => {
+    const row = recordValue(value, 'lowest fare row')
+    if (!isIsoDate(row.flightDate)) throw dataError('Invalid fare date')
+    if (row.noFlight != null && typeof row.noFlight !== 'boolean') throw dataError('Invalid no-flight flag')
+    if (!row.noFlight && row.totalPrice == null && row.totalPriceItinerary == null) throw dataError('Missing fare amount')
+    if (!row.noFlight) roundTripFloor(row as LowestFareOffer, flow === 'REWARD' || row.currency === 'MILES')
