+    for (const cache of caches) expect((await cache.getOrLoad('race', async () => loader())).cacheHit).toBe(false)
+  })
+
+})
+
+describe('reward preparation does not reissue rejected operations', () => {
+  it.each([401, 403, 429, 503])('never repeats CreateSearchContext after HTTP%i', async (status) => {
+    mocks.retry.mockResolvedValueOnce({ data: { customer: {} } }).mockRejectedValueOnce(failure(status))
+    await expect(prepareRewardSession(page, request)).rejects.toMatchObject({ status })
+    expect(mocks.retry).toHaveBeenCalledTimes(2)
