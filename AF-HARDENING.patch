+    mocks.retry.mockResolvedValueOnce({ data: { customer: {} } }).mockResolvedValueOnce({ data: { createSearchContext: { possibleTravelersFromProfile: [{ travelerKey }] } } })
+    await expect(prepareRewardSession(page, request)).rejects.toBeInstanceOf(AirFranceResponseError)
